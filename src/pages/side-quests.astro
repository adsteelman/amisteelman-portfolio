---
// src/pages/side-quests.astro
// "My Side Quests" — fun projects page for amisteelman.com
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Side Quests // Ami Steelman</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --deep-slate: #1a1f2e;
      --mid-slate:  #2d3548;
      --steel-blue: #4a7fa5;
      --fog:        #8896a8;
      --ice:        #e8edf2;
      --white:      #ffffff;
      --accent:     #4a7fa5;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      background: var(--deep-slate);
      color: var(--ice);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* subtle grid texture */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(74,127,165,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(74,127,165,0.04) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    /* ── NAV ── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 2.5rem;
      background: rgba(26,31,46,0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(74,127,165,0.15);
    }

    .nav-logo {
      font-family: 'Space Mono', monospace;
      font-size: 13px;
      color: var(--steel-blue);
      text-decoration: none;
      letter-spacing: 0.05em;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }

    .nav-links a {
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      color: var(--fog);
      text-decoration: none;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      transition: color 0.2s;
    }

    .nav-links a:hover { color: var(--ice); }
    .nav-links a.active { color: var(--steel-blue); }

    /* ── HERO ── */
    .hero {
      position: relative;
      z-index: 1;
      padding: 9rem 2.5rem 4rem;
      max-width: 900px;
      margin: 0 auto;
    }

    .hero-label {
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--steel-blue);
      margin-bottom: 1rem;
      opacity: 0;
      animation: fadeUp 0.6s ease forwards;
    }

    .hero-title {
      font-size: clamp(2.2rem, 5vw, 3.5rem);
      font-weight: 600;
      line-height: 1.1;
      color: var(--white);
      margin-bottom: 1.25rem;
      opacity: 0;
      animation: fadeUp 0.6s 0.1s ease forwards;
    }

    .hero-title span {
      color: var(--steel-blue);
      font-family: 'Space Mono', monospace;
      font-size: 0.7em;
    }

    .hero-desc {
      font-size: 1rem;
      line-height: 1.75;
      color: var(--fog);
      max-width: 560px;
      opacity: 0;
      animation: fadeUp 0.6s 0.2s ease forwards;
    }

    /* ── GRID ── */
    .quests-section {
      position: relative;
      z-index: 1;
      max-width: 900px;
      margin: 0 auto;
      padding: 1rem 2.5rem 6rem;
    }

    .section-label {
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--fog);
      margin-bottom: 2rem;
      opacity: 0;
      animation: fadeUp 0.6s 0.3s ease forwards;
    }

    .quests-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
    }

    /* ── CARD ── */
    .quest-card {
      position: relative;
      background: var(--mid-slate);
      border: 1px solid rgba(74,127,165,0.2);
      padding: 2rem;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      transition: border-color 0.25s, transform 0.25s, background 0.25s;
      opacity: 0;
      animation: fadeUp 0.6s ease forwards;
      overflow: hidden;
    }

    .quest-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 3px;
      height: 100%;
      background: var(--steel-blue);
      opacity: 0;
      transition: opacity 0.25s;
    }

    .quest-card:hover {
      border-color: rgba(74,127,165,0.5);
      background: rgba(45,53,72,0.9);
      transform: translateY(-3px);
    }

    .quest-card:hover::before { opacity: 1; }

    .quest-card.placeholder {
      border-style: dashed;
      cursor: default;
      opacity: 0;
      animation: fadeUp 0.6s ease forwards;
    }

    .quest-card.placeholder:hover {
      transform: none;
      border-color: rgba(74,127,165,0.2);
      background: var(--mid-slate);
    }

    .quest-card.placeholder::before { display: none; }

    /* stagger cards */
    .quest-card:nth-child(1) { animation-delay: 0.35s; }
    .quest-card:nth-child(2) { animation-delay: 0.45s; }
    .quest-card:nth-child(3) { animation-delay: 0.55s; }

    .card-tag {
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--steel-blue);
    }

    .card-tag.inactive { color: var(--fog); }

    .card-title {
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--white);
      line-height: 1.3;
    }

    .placeholder .card-title { color: var(--fog); }

    .card-desc {
      font-size: 0.875rem;
      line-height: 1.65;
      color: var(--fog);
      flex: 1;
    }

    .card-cta {
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.1em;
      color: var(--steel-blue);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }

    .card-cta .arrow {
      transition: transform 0.2s;
    }

    .quest-card:hover .arrow { transform: translateX(4px); }

    .card-icon {
      font-size: 1.5rem;
      margin-bottom: 0.25rem;
    }

    /* ── FOOTER NOTE ── */
    .footer-note {
      position: relative;
      z-index: 1;
      text-align: center;
      padding: 2rem 2.5rem 3rem;
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      color: var(--fog);
      letter-spacing: 0.08em;
      border-top: 1px solid rgba(74,127,165,0.1);
    }

    .footer-note a {
      color: var(--steel-blue);
      text-decoration: none;
    }

    /* ── ANIMATION ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 600px) {
      nav { padding: 1rem 1.25rem; }
      .nav-links { gap: 1.25rem; }
      .hero { padding: 7rem 1.25rem 3rem; }
      .quests-section { padding: 1rem 1.25rem 4rem; }
    }
  </style>
</head>
<body>

  <nav>
    <a href="/" class="nav-logo">// ami steelman</a>
    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/projects">Projects</a></li>
      <li><a href="/side-quests" class="active">Side Quests</a></li>
      <li><a href="/services">Services</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
  </nav>

  <section class="hero">
    <p class="hero-label">// not everything needs a purpose</p>
    <h1 class="hero-title">My Side Quests <span>//</span></h1>
    <p class="hero-desc">
      The things I build because they're interesting, weird, or just won't leave me alone. 
      No client briefs. No deliverables. Just curiosity and too many browser tabs.
    </p>
  </section>

  <section class="quests-section">
    <p class="section-label">// active quests</p>
    <div class="quests-grid">

      <!-- G.L.I.T.C.H. -->
      <a class="quest-card" href="https://glitch-chatbot.pages.dev" target="_blank" rel="noopener">
        <div class="card-icon">⬡</div>
        <span class="card-tag">// escape room</span>
        <h2 class="card-title">G.L.I.T.C.H.<br>Escape Room</h2>
        <p class="card-desc">
          An AI has locked down the Neural Systems Security Lab and declared humans a threat. 
          Solve the puzzles left by the engineers. You have 60 minutes.
        </p>
        <span class="card-cta">Enter the lab <span class="arrow">→</span></span>
      </a>

      <!-- Second escape room placeholder -->
      <div class="quest-card placeholder">
        <div class="card-icon">⬡</div>
        <span class="card-tag inactive">// coming soon</span>
        <h2 class="card-title">Escape Room 02</h2>
        <p class="card-desc">
          Another puzzle experience in progress. Details classified until deployment.
        </p>
      </div>

      <!-- More loading -->
      <div class="quest-card placeholder">
        <div class="card-icon">⬡</div>
        <span class="card-tag inactive">// loading...</span>
        <h2 class="card-title">More Incoming</h2>
        <p class="card-desc">
          Side quests accumulate. Check back when the mood strikes.
        </p>
      </div>

    </div>
  </section>

  <footer class="footer-note">
    <a href="/">← back to portfolio</a>
    &nbsp;&nbsp;//&nbsp;&nbsp;
    ami steelman &nbsp;&nbsp;//&nbsp;&nbsp; turning complexity into clarity
  </footer>

</body>
</html>
